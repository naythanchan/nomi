# Copy to backend/.env and fill in.

# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Where the app runs (used to build the OAuth redirect URI)
BASE_URL=http://localhost:8080

# SQLite by default; point at Postgres later with a full SQLAlchemy URL if you want.
DATABASE_URL=sqlite:///./nomi.db

# Restrict directory search / attendees to one email domain (optional). Blank = no restriction.
ORG_EMAIL_DOMAIN=columbia.edu

# Google OAuth client secret file (download from Google Cloud Console → Credentials → OAuth client → Web).
# Place the JSON at backend/client_secret.json (default) or point elsewhere here.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# OpenAI API key — enables the natural-language ("just describe it") and
# chat ("are Ava and Bob free at 3pm?") features. Without it, those endpoints
# return 503 and the app falls back to the manual scheduling flow.
# Get one at https://platform.openai.com/api-keys .
OPENAI_API_KEY=

# Which OpenAI model to use. Default is a low-cost nano-tier model; change it
# if your account doesn't have this one (e.g. gpt-4o-mini).
OPENAI_MODEL=gpt-4.1-nano
